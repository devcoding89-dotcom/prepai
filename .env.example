# ---------------------------------------------------------------------------
# PrepAI environment
# Copy to .env.local. Everything is optional in development: with no variables
# set the app runs on its built-in JSON database and simulated payments.
# ---------------------------------------------------------------------------

# Signing key for session cookies (required in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Public site URL — used for OG tags and Paystack callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (set these to switch off the local JSON database) ------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# SUPABASE_STORAGE_BUCKET=textbooks
#
# REQUIRED when using the isolated-schema install (migration 0002_isolated_schema.sql).
# The tables live in a dedicated `prepai` schema, not `public`. Without this
# variable the app queries the `public` schema and every table lookup 404s.
# See README §4.1. Must be set in BOTH .env.local AND the Vercel dashboard.
SUPABASE_DB_SCHEMA=prepai

# --- Paystack (set to take live payments; otherwise checkout is simulated) -
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# Where the local JSON database is written (default: ./data)
# PREPAI_DATA_DIR=./data
